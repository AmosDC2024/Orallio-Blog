# SANITY CMS CONFIGURATION
# Sanity Configuration
# Replace these placeholders with your actual values in your local .env.local
# or in your hosting provider's environment variables.

NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=your-sanity-dataset
NEXT_PUBLIC_SANITY_API_VERSION=your-sanity-api-version
SANITY_STUDIO_DATASET=your-sanity-dataset
SANITY_STUDIO_PROJECT_ID=your-sanity-project-id

# NAMECHEAP PRIVATE EMAIL SMTP CONFIGURATION
# Set these in your local environment / hosting provider (Vercel / Netlify / VPS)
SMTP_HOST=your-smtp-host
SMTP_PORT=your-smtp-port
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# DYNAMIC MAILBOX DESTINATION ROUTING
# Set these in your local environment / hosting provider.
CONTACT_RECEIVER_EMAIL=your-contact-receiver-email
WORK_WITH_US_RECEIVER_EMAIL=your-work-with-us-receiver-email

