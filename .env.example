# SANITY CMS CONFIGURATION
# Replace these with your actual Sanity project values from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=orallio_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PROJECT_ID=orallio_project_id

# NAMECHEAP PRIVATE EMAIL SMTP CONFIGURATION
# Set these in your local environment / hosting provider (Vercel / Netlify / VPS)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=godwin@orallio.com
SMTP_PASS=your_private_email_password_here

# DYNAMIC MAILBOX DESTINATION ROUTING
